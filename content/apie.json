{
  "text_001": "nomeda mar&ccaron;&edot;nait&edot;",
  "text_002": "Prad&zcaron;ia",
  "text_003": "K&umacr;ryba",
  "text_004": "Parodos",
  "text_005": "Edukacijos",
  "text_006": "Renginiai",
  "text_007": "Apie",
  "text_008": "Kontaktai",
  "text_009": "EN",
  "text_010": "Apie meninink&eogon;",
  "text_011": "Nomeda Mar&ccaron;&edot;nait&edot;",
  "text_012": "K&umacr;ryba, kuri kalbasi su gyvenimu.",
  "text_013": "Meninink&edot; &middot; k&umacr;r&edot;ja &middot; rengini&uogon; ved&edot;ja",
  "text_014": "K&umacr;ryba be vieno apibr&edot;&zcaron;imo",
  "text_015": "Nomeda Mar&ccaron;&edot;nait&edot; kuria keramik&aogon;, skulpt&umacr;r&aogon; ir tapyb&aogon;, dalyvauja parodose, rengia k&umacr;rybines edukacijas bei veda renginius.",
  "text_016": "Jos k&umacr;ryboje susitinka kasdieniai objektai, &zcaron;mogi&scaron;kos istorijos, ironija ir jautrumas. Meno k&umacr;rinys &ccaron;ia gali tapti ir pasakojimu, ir klausimu, ir netik&edot;tu susitikimu.",
  "text_017": "Tai redakcinis pristatymas. I&scaron;samus CV ir biografiniai faktai bus papildyti patikrintu archyvu.",
  "text_018": "K&umacr;rybin&edot;s kryptys",
  "text_019": "Keramika",
  "text_020": "Autoriniai objektai, skulpt&umacr;rin&edot;s formos, kasdienyb&edot;s simboliai.",
  "text_021": "Per&zcaron;i&umacr;r&edot;ti k&umacr;rinius",
  "text_022": "Tapyba",
  "text_023": "Vaizdiniai pasakojimai ir spalvos pasaulis.",
  "text_024": "K&umacr;rybos archyvas",
  "text_025": "Susitikimai",
  "text_026": "Edukacijos, pokalbiai ir gyvas k&umacr;rybos procesas.",
  "text_027": "Atrasti edukacijas",
  "text_028": "Leidiniai ir tekstai",
  "text_029": "Knygos ir autoriniai tekstai",
  "text_030": "&bdquo;L&edot;l&edot;&ldquo;",
  "text_031": "Leidini&uogon; archyvo &iogon;ra&scaron;as. Bibliografiniai duomenys tikslinami.",
  "text_032": "&bdquo;Virtuv&edot;s u&zcaron;ra&scaron;ai&ldquo;",
  "text_033": "Leidini&uogon; archyvo &iogon;ra&scaron;as. Bibliografiniai duomenys tikslinami.",
  "text_034": "Kontaktai"
}
