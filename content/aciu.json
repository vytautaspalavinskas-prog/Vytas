  "text_001": "nomeda mar&ccaron;&edot;nait&edot;",
  "text_002": "EN",
  "text_003": "U&zcaron;klausa",
  "text_004": "A&ccaron;i&umacr;!",
  "text_005": "J&umacr;s&uogon; &zcaron;inut&edot; pateikta.",
  "text_006": "Susisieksime su jumis nurodytu el. pa&scaron;tu.",
  "text_007": "Gr&iogon;&zcaron;ti &iogon; prad&zcaron;i&aogon;"
