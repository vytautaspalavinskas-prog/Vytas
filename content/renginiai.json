  "text_001": "nomeda mar&ccaron;&edot;nait&edot;",
  "text_002": "Prad&zcaron;ia",
  "text_003": "K&umacr;ryba",
  "text_004": "Parodos",
  "text_005": "Edukacijos",
  "text_006": "Renginiai",
  "text_007": "Apie",
  "text_008": "Kontaktai",
  "text_009": "EN",
  "text_010": "Renginiai &middot; bendradarbiavimas",
  "text_011": "Susitikimai ir scena",
  "text_012": "Gyvas pokalbis, gera istorija ir tikras ry&scaron;ys su auditorija.",
  "text_013": "Rengini&uogon; vedimas",
  "text_014": "Renginys prasideda nuo &zcaron;moni&uogon;",
  "text_015": "Nomeda Mar&ccaron;&edot;nait&edot; veda renginius, moderuoja pokalbius, dalyvauja susitikimuose ir pristato k&umacr;rybines programas. Renginio scenarijus ir tonas pritaikomi jo temai bei auditorijai.",
  "text_016": "Pakviesti Nomed&aogon;",
  "text_017": "01",
  "text_018": "Rengini&uogon; vedimas",
  "text_019": "&Scaron;vent&edot;s, kult&umacr;ros renginiai, organizacij&uogon; susitikimai.",
  "text_020": "02",
  "text_021": "Pokalbi&uogon; moderavimas",
  "text_022": "Diskusijos, konferencijos ir vie&scaron;i susitikimai.",
  "text_023": "03",
  "text_024": "K&umacr;rybiniai susitikimai",
  "text_025": "Autoriniai pasakojimai, pokalbiai apie men&aogon; ir edukacin&edot;s programos.",
  "text_026": "Turite renginio id&edot;j&aogon;?",
  "text_027": "Para&scaron;ykite dat&aogon;, viet&aogon;, auditorijos dyd&iogon; ir trump&aogon; renginio apra&scaron;ym&aogon; &ndash; taip bus lengviau parengti konkret&uogon; pasi&umacr;lym&aogon;.",
  "text_028": "Si&uogon;sti u&zcaron;klaus&aogon;",
  "text_029": "Kontaktai"
}
